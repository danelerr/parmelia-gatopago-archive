{
  "$schema": "./node_modules/knip/schema.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "project": [
        "scripts/**/*.mjs"
      ],
      "ignoreBinaries": [
        "cast",
        "forge",
        "java"
      ],
      "ignoreDependencies": [
        "wrangler"
      ]
    },
    "gatopago-wallet-core": {
      "ignoreBinaries": [
        "anvil"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "test-worker/**/*.ts"
      ],
      "ignoreDependencies": [
        "cloudflare"
      ]
    },
    "gatopago-flow": {
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "test-worker/**/*.ts"
      ],
      "ignoreDependencies": [
        "cloudflare"
      ]
    },
    "shared": {
      "project": [
        "**/*.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/wallet/BackupCommitPanel.tsx"
      ]
    }
  },
  "ignore": [
    "contracts/lib/**"
  ]
}
