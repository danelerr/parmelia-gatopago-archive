{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "test",
    "../shared",
    "vitest.config.ts",
    "vitest.worker.config.ts",
    "worker-configuration.d.ts",
    "v3/bindings.d.ts",
    "vitest.v3-worker.config.ts"
  ]
}
