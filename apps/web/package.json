{
  "name": "@gatopago/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:wallet-harness": "node test/serve-wallet-overview.mjs",
    "dev:enrollment-harness": "node test/serve-enrollment.mjs",
    "dev:activation-policy-harness": "node test/serve-activation-policy.mjs",
    "dev:activation-harness": "node test/serve-activation-policy.mjs --activation",
    "dev:activation-commit-harness": "node test/serve-activation-commit.mjs",
    "dev:balances-harness": "node test/serve-balances.mjs",
    "dev:transfers-harness": "node test/serve-transfers.mjs",
    "dev:transfer-review-harness": "node test/serve-transfer-review.mjs",
    "build": "node ../../scripts/v3-web-release.mjs && next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/recursive": "5.3.0",
    "@gatopago/brand": "workspace:*",
    "@gatopago/environment": "workspace:*",
    "@gatopago/shared": "workspace:*",
    "firebase": "12.18.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.0",
    "esbuild": "0.28.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.11",
    "viem": "2.55.19"
  }
}
