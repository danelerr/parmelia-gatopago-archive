@startuml
!include _theme.puml
title GatoPago — Futuro: PaymentIntent con settlement Stellar

actor "Negocio" as merchant
participant "Payments API" as api COLOR_LIVE
database "Payments D1" as db COLOR_DATA
actor "Pagador" as payer
participant "Checkout / SDK" as checkout COLOR_WEB
participant "Quote + Route Engine" as router COLOR_LIVE
participant "Stellar Adapter" as stellar COLOR_EXTERNAL
participant "Stellar RPC / SAC" as network COLOR_EXTERNAL
queue "Payments Jobs" as jobs COLOR_LIVE

merchant -> api : crear intent\nasset + monto + SettlementDestination Stellar
api -> db : intent awaiting_payment\nnetwork_id + asset_id + address_type
api --> merchant : pi_... + checkout URL

payer -> checkout : abre y elige Stellar
checkout -> api : solicitar quote\nsource account G... o C...
api -> router : cotizar ruta local Stellar
router -> stellar : validar SAC, trustline/muxed y fees
stellar -> network : simulateTransaction
network --> stellar : footprint + resource fee
stellar --> router : execution payload + expiración
router --> api : quote inmutable
api -> db : quote + adapter generation
api --> checkout : XDR/auth entries tipadas

payer -> checkout : autoriza
checkout -> stellar : firma transacción/auth entry
stellar -> network : submit fee-bump o self-funded
network --> stellar : transaction hash
stellar -> api : submission_id + hash
api -> db : attempt submitted
api -> jobs : reconcile Stellar

jobs -> network : transaction/meta/events/finality
network --> jobs : evidencia SAC exacta
jobs -> db : confirmed + settlement + outbox
api --> merchant : webhook payment.succeeded\nnetwork_id + asset_id + ledger

note over api,network
  El submit no declara pago.
  La API pública no expone supuestos 0x/chainId.
end note

@enduml
