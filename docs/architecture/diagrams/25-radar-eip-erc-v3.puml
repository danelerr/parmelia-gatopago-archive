@startuml
!include _theme.puml
title GatoPago V3 — Radar ERC/EIP

left to right direction
skinparam linetype ortho

package "Base Account V3" COLOR_READY {
  component "4337 / 712 / 1271" as core1 COLOR_READY
  component "7913 / 7951 / 6492" as core2 COLOR_READY
  component "165 / 1967 / 7201 / 5267" as core3 COLOR_READY
  component "1014 + 1822 UUPS" as deployment COLOR_READY
  component "721 + 1155 receivers" as core4 COLOR_READY
}

package "Adapters de pagos e infraestructura" COLOR_LIVE {
  component "20 / 2612 / 3009 / 681" as payments COLOR_LIVE
  component "4361 / 5792 / 7702" as wallets COLOR_LIVE
  component "7677 / 7769 / 7562" as infra COLOR_LIVE
}

package "Piloto Testnet / observar" COLOR_EXTERNAL {
  component "7579 / 7484 / 6900 / 7821" as modules COLOR_EXTERNAL
  component "7739 / 7730" as signing COLOR_EXTERNAL
  component "7710 / 7715" as permissions COLOR_EXTERNAL
  component "7930 / 7683" as intents COLOR_EXTERNAL
  component "4626 / 7540" as earn COLOR_EXTERNAL
}

package "Fuera del account core" COLOR_FUTURE {
  component "2535 Diamonds" as diamond COLOR_FUTURE
  component "2771 trusted forwarder" as forwarder COLOR_FUTURE
  component "1363 / 777 callbacks" as callbacks COLOR_FUTURE
  component "módulos arbitrarios" as arbitrary COLOR_FUTURE
}

core1 --> payments : autoriza ejecución
core2 --> wallets : firmas portables
core3 --> modules : adapter, no dependencia
deployment --> core1 : deploy determinístico / upgrade ADR
wallets --> infra : capabilities
payments --> intents : PaymentIntent
modules --> permissions : sólo opt-in
permissions --> signing : consentimiento legible
earn --> core1 : CALL externo auditado

note bottom of modules
  Ausentes en V3.0. Si existe un caso real,
  evaluar 7579 o 6900; nunca ambos.
end note

note bottom of arbitrary
  Estar estandarizado no implica
  ser adecuado para GatoPago.
end note

@enduml
