@startuml
!include _theme.puml
title V3 revisión 2 — Web y ambientes objetivo (especificación)
left to right direction
actor "Persona" as person
actor "Empresa / integrador" as business
package "Producción" {
  component "gatopago.com\nNext.js: landing + App + checkout\nRP: gatopago.com" as web COLOR_WEB
  component "business.gatopago.com\nDashboard independiente" as dash COLOR_WEB
  rectangle "api.gatopago.com\nRouting por recurso, sin DB" as routes
  component "Wallet Core\n/app/v1 y wallets/transfers" as wallet COLOR_READY
  component "Flow Core\n/v1 Flow + /checkout/v1" as flow COLOR_READY
  database "Wallet D1" as wd COLOR_DATA
  database "Flow D1" as fd COLOR_DATA
  cloud "Firebase producción" as auth COLOR_EXTERNAL
}
package "Staging — recursos y credenciales separados" {
  component "staging.gatopago.com\nRP: staging.gatopago.com" as sw COLOR_WEB
  component "business.staging.gatopago.com" as sd COLOR_WEB
  rectangle "api.staging.gatopago.com" as sr
  component "Wallet / Flow de staging\nD1, Queue/DLQ, DO, signers propios" as sb COLOR_READY
  cloud "Firebase staging" as sa COLOR_EXTERNAL
}
person --> web
business --> dash
business --> routes
web --> routes
dash --> routes
web --> auth
routes --> wallet
routes --> flow
wallet --> wd
flow --> fd
wallet --> flow : Service Binding tipado
sw --> sr
sd --> sr
sr --> sb
sw --> sa
note bottom of web
  / marketing; /app cuenta; /pay/... checkout
  /__/auth/* proxy Firebase, excluido del SW
  API y datos privados no se cachean.
  Origins exactos; subdominio no basta para aislamiento.
end note
note bottom of sb
  environment != API mode != blockchain tier
  staging: test + testnet; previews: mocks/efímeros
  mainnet requiere un gate y autorización separados.
end note
@enduml
