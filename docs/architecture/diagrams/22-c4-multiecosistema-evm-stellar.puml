@startuml
!include _theme.puml
title GatoPago — Futuro: C4 multiecosistema EVM + Stellar

left to right direction
skinparam linetype ortho

actor "Persona / negocio" as user

package "Clientes" {
  component "App / Checkout / Dashboard" as clients COLOR_WEB
  component "Emergency client" as emergency COLOR_READY
}

package "GatoPago" {
  component "App Worker" as app COLOR_LIVE
  component "Payments Worker" as payments COLOR_LIVE
  component "NetworkExecutionPort" as port COLOR_LIVE
  database "Account Identity +\ninstances por network" as app_db COLOR_DATA
  database "Intents + routes +\nevidence" as payments_db COLOR_DATA
}

package "EVM Adapter" {
  component "viem / ERC-4337" as evm_adapter COLOR_EXTERNAL
  component "bundler / paymaster / RPC" as evm_providers COLOR_EXTERNAL
  node "EVM Account Group\nmisma dirección 0x..." as evm_accounts COLOR_EXTERNAL
}

package "Stellar Adapter futuro (no bloquea V3)" {
  component "Stellar SDK / XDR / simulation" as stellar_adapter COLOR_EXTERNAL
  component "RPC / Horizon / fee sponsor" as stellar_providers COLOR_EXTERNAL
  node "Stellar Contract Account\ndirección C..." as stellar_account COLOR_EXTERNAL
  component "SAC / SEP-41 / CCTP" as stellar_assets COLOR_EXTERNAL
}

user --> clients
clients --> app
clients --> payments
app --> app_db
payments --> payments_db
app --> port
payments --> port
port --> evm_adapter
port --> stellar_adapter
evm_adapter --> evm_providers
evm_providers --> evm_accounts
stellar_adapter --> stellar_providers
stellar_providers --> stellar_account
stellar_account --> stellar_assets
emergency --> evm_providers
emergency --> stellar_providers

note bottom of app_db
  wallet_id vincula las instancias.
  account_identity_id identifica el grupo EVM.
  Las direcciones y estados son nativos
  de cada ecosistema.
end note

note bottom of port
  No se crea otro Worker inicialmente.
  Se extrae sólo con evidencia operativa.
end note

@enduml
