@startuml
!include _theme.puml
title GatoPago V3 — Activos, intents y ejecución

start
:Usuario expresa resultado\n(assetId CAIP-19, monto, destino, límites);
:Intent Engine valida identidad,\nchain y asset exactos;

if (Asset tier trusted?) then (sí)
  :habilita quote/routing normal;
else (no)
  if (discovered/custom y acción personal?) then (sí)
    :muestra metadata no confiable,\nred y riesgo explícitos;
  else (no)
    :bloquea routing o settlement automático;
    stop
  endif
endif

:Quote Engine consulta adapters disponibles;
:congela route, contratos, slippage,\nNetworkCost y PlatformFeePolicy;

if (Simulación y límites pasan?) then (sí)
  :SponsorshipPolicy elige paymaster\no self-funded;
else (no)
  :no solicita firma;
  stop
endif

:Usuario autoriza calls exactas;
:Account V3 ejecuta CALL/batch genérico;
:Queue reconcilia receipts y finality;

if (Evidencia onchain coincide?) then (sí)
  :confirmed + receipt detallado;
else (no)
  :pending / failed / needs_review;
endif

stop

note right
  La cuenta soporta calls EVM genéricas.
  Payments acepta sólo assets/rutas aprobados.
  Nunca se confía en symbol/name/decimals.
end note

@enduml

