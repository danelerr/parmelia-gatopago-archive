@startuml
!include _theme.puml
title GatoPago V3 revisión 2 — objetivo especificado, no desplegado

left to right direction
skinparam linetype ortho

actor "Persona" as person
actor "Negocio" as merchant
actor "Integración B2B" as b2b

package "Clientes" {
  component "Next.js apps/web\ngatopago.com\nMarketing + Consumer + PWA" as app_web COLOR_WEB
  component "Checkout público\nMismo proyecto Next.js" as checkout COLOR_WEB
  component "Dashboard B2B" as dashboard COLOR_WEB
  component "Emergency client / CLI\nAbierto y reproducible" as emergency COLOR_READY
}

package "Dominios GatoPago" {
  component "Wallet Core (gatopago-wallet-core/)\nIdentidad, Party, Wallet, manifests,\nportfolio y operaciones" as app COLOR_READY
  database "App D1\nAccount Identity + estado por chain" as app_db COLOR_DATA
  queue "App Jobs" as app_jobs COLOR_LIVE
  component "ChainExecution\nComponente lógico + DO" as execution COLOR_LIVE

  component "Flow Core (gatopago-flow/)\nTenancy, intents, settlement,\njournal y webhooks" as payments COLOR_READY
  database "Payments D1\nIntent + attempt + outbox" as payments_db COLOR_DATA
  queue "Payments Jobs" as payments_jobs COLOR_LIVE
}

package "Puertos reemplazables" {
  component "RPC / Bundler adapters" as rpc COLOR_EXTERNAL
  component "Paymaster adapters\nGatoPago / ERC-7677 / externo" as paymasters COLOR_EXTERNAL
  component "Swap / Bridge / CCTP adapters" as routes COLOR_EXTERNAL
  component "Asset metadata / prices" as assets COLOR_EXTERNAL
}

node "EVM wallet rail" as evm COLOR_EXTERNAL {
  component "Canonical Account V3 stack\nmisma address + codehash" as stack
  component "Cuenta 0xABC...\nmisma dirección por chain" as account
  component "Routers versionados" as routers
}

cloud "Firebase Auth" as firebase COLOR_EXTERNAL

person --> app_web
person --> checkout
person --> emergency : salida sin GatoPago
merchant --> dashboard
b2b --> payments : API /v1

app_web --> app
checkout --> payments
dashboard --> payments
dashboard --> firebase
app_web --> firebase
app --> app_db
app --> app_jobs
app_jobs --> execution
execution --> rpc
execution --> paymasters
execution --> account

payments --> payments_db
payments --> payments_jobs
payments_jobs --> routes
routes --> routers
app --> payments : Service Binding tipado\noperaciones/eventos cuando corresponda

app --> assets
payments --> assets
stack --> account : deploy contrafactual
emergency --> rpc
emergency --> account : control / recovery / sweep

note bottom of stack
  Una chain entra al wallet rail sólo si replica
  factory, implementación y verifiers con las
  mismas direcciones y runtime codehashes.
end note

note bottom of payments
  Payments congela SettlementDestination.
  No conoce la generación interna de la cuenta.
  Flow acepta wallets externas sin Account V3.
  api.gatopago.com enruta por recurso al owner.
end note

@enduml
